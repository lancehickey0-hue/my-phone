{
  "expo": {
    "name": "My-Phone",
    "slug": "my-phone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myphone",
    "userInterfaceStyle": "dark",
    "owner": "lannyboi253",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon1.png",
      "resizeMode": "contain",
      "backgroundColor": "#06060A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myphone.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "My-Phone needs microphone access for voice recognition wake word detection",
        "NSLocationWhenInUseUsageDescription": "My-Phone needs location access to track your devices",
        "NSLocationAlwaysUsageDescription": "My-Phone needs background location to show your device on the map",
        "NSFaceIDUsageDescription": "My-Phone uses Face ID to verify your identity when unlocking devices",
        "UIBackgroundModes": ["location", "audio", "fetch"]
      }
    },
    "android": {
      "package": "com.myphone.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon1.png",
        "backgroundColor": "#06060A"
      },
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "./plugins/wake-word/index.js",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "My-Phone needs your location to track devices on the map.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a57089db-f8e0-4314-888b-29c19c9665cb"
      }
    }
  }
}
